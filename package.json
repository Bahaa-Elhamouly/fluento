{
  "name": "Fluento",
  "private": true,

  "packageManager": "npm@11.7.0",

  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test:backend": "cd backend/fluento-api && mvnw.cmd test",
    "test:web-build": "npm run build --workspace web",
    "qa:audit": "npm audit --audit-level=high",
    "qa:all": "npm run check-types && npm run lint && npm run test:web-build && npm run qa:audit"
  },

  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.8",
    "typescript": "5.9.2"
  },

  "engines": {
    "node": ">=18"
  },

  "workspaces": [
    "frontend/*",
    "packages/*"
  ]
}
