{
  "info": {
    "name": "Fluento MVP API",
    "description": "Core API smoke collection for Fluento MVP endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Public status",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/public/status"
      }
    },
    {
      "name": "Register learner",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Sara\",\n  \"lastName\": \"Ahmed\",\n  \"email\": \"sara.qa@example.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/register"
      }
    },
    {
      "name": "Login learner",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.data?.accessToken) pm.collectionVariables.set('accessToken', json.data.accessToken);",
              "if (json.data?.refreshToken) pm.collectionVariables.set('refreshToken', json.data.refreshToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"sara.qa@example.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "List courses",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/catalog/courses"
      }
    },
    {
      "name": "Progress summary",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/progress/me"
      }
    }
  ]
}
